# API 环境变量（复制为 apps/api/.env，不要提交）

# Neon：运行时使用的 pooled 连接串（主机名带 -pooler）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/allisteam?sslmode=require&connect_timeout=15"

# Neon：迁移与 prisma CLI 使用的直连串（不带 -pooler）
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/allisteam?sslmode=require&connect_timeout=15"

# Upstash Redis（必须 TLS）
REDIS_URL="rediss://default:password@xxx.upstash.io:6379"

# 认证
JWT_ACCESS_SECRET="replace-with-node-crypto-randombytes-hex"
JWT_ACCESS_TTL="30m"
REFRESH_TTL_DAYS="14"

# 服务
PORT="3001"
WEB_ORIGIN="http://localhost:3000"

# 管理员白名单，逗号分隔
ADMIN_EMAILS=""

# 集成测试专用库（可选）。设置后 `npm test` 会改写 DATABASE_URL 指向它，
# 绝不污染开发库；不设置则跳过全部集成测试，只跑单元测试。
# TEST_DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/allisteam_test?sslmode=require&connect_timeout=15"
